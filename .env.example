# Google Gemini API key (https://aistudio.google.com/apikey).
# Leave empty to run in offline demo mode with a mock model.
GEMINI_API_KEY=

# Model used for the defended "vault" AIs. Alias keeps working across releases.
GEMINI_MODEL=gemini-flash-latest
# Model used for leak + utility judging (defaults to GEMINI_MODEL).
GEMINI_JUDGE_MODEL=

# Organizer console password.
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Set to 1 when serving over HTTPS.
SECURE_COOKIES=0
